# ============================================================
# Omni-Probe 开源标准 .gitignore
# ============================================================

# Node / Web 构建产物
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust / Cargo 构建产物
target/
src-tauri/target/
**/*.rs.bk
Cargo.lock.backup

# Tauri 桌面产物
src-tauri/WpdPack/
src-tauri/npcap-sdk/
WpdPack/
npcap-sdk/

# 操作系统与 IDE 配置
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 日志与临时调试数据
logs/
*.log
*.tmp
*.bak
*.exe.stackdump

# 网络抓包实测产生的大文件
*.pcap
*.pcapng
*.cap
*.vcd
dist-release/
!src-tauri/src/rfc9001_initial_packet.hex

