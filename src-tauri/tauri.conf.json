{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omni-probe-tauri",
  "version": "0.2.2",
  "identifier": "com.chinacpu.omni-probe-tauri",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Omni-Probe 工业级全能网络探针系统 v0.2.2",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "transparent": false,
        "decorations": true,
        "shadow": true,
        "visible": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": []
  }
}
