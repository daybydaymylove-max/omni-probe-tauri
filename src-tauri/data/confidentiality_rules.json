  "document_signatures": [
    {
      "id": "SIG-RED-HEADER-CENTRAL",
      "name": "中共中央/国务院核心红头公文字号",
      "pattern": "(?:中发|中办发|中办字|国发|国办发|国办字|中纪发)[\\s]*[〔\\[\\(（]\\d{4}[〕\\]\\)）][\\s]*\\d+号",
      "severity": "CRITICAL",
      "description": "中共中央办公厅与国务院办公厅最高级别发文字号"
    },
    {
      "id": "SIG-RED-HEADER-MINISTRY",
      "name": "国家部委规范发文字号",
      "pattern": "(?:水规计|水资|水保|水防|办水|发改投资|发改高技|工信部网安|工信部信发|公通字|公治字|公网安|财预|财建|国资发|科发|国能发|自然资发|环发|应急发)[\\s]*[〔\\[\\(（]\\d{4}[〕\\]\\)）][\\s]*\\d+号",
      "severity": "HIGH",
      "description": "水利部、发改委、工信部、公安部、财政部等国家部委发文字号"
    },
    {
      "id": "SIG-RED-HEADER-PROVINCIAL",
      "name": "省级党委与人民政府发文字号",
      "pattern": "[\\u4e00-\\u9fa5]{1,3}(?:省委|省府|省办|市委|市府|市办|委发|政发|办发)[\\s]*[〔\\[\\(（]\\d{4}[〕\\]\\)）][\\s]*\\d+号",
      "severity": "HIGH",
      "description": "各省直辖市党委与人民政府规范公文发文字号"
    },
    {
      "id": "SIG-RED-HEADER-JUDICIAL",
      "name": "最高人民法院与最高人民检察院发文字号",
      "pattern": "(?:法发|法释|法办|高检发|高检检发)[\\s]*[〔\\[\\(（]\\d{4}[〕\\]\\)）][\\s]*\\d+号",
      "severity": "HIGH",
      "description": "司法机关法律解释与审判业务指导性公文发文字号"
    },
    {
      "id": "SIG-RED-HEADER-MILITARY",
      "name": "国防军工与部队公文字号",
      "pattern": "(?:军发|军办发|装发|科工发|参发|政发)[\\s]*[〔\\[\\(（]\\d{4}[〕\\]\\)）][\\s]*\\d+号",
      "severity": "CRITICAL",
      "description": "国防军事装备研发与涉密保障公文字号"
    },
    {
      "id": "SIG-RED-HEADER-GENERAL",
      "name": "企事业单位通用规范公文字号",
      "pattern": "[\\u4e00-\\u9fa5]{2,12}(?:发|办发|委发|函|计发|纪发|通|令)[\\s]*[〔\\[\\(（]\\d{4}[〕\\]\\)）][\\s]*\\d+号",
      "severity": "HIGH",
      "description": "标准党政企事业单位发文字号排版格式（GB/T 9704-2012）"
    },
    {
      "id": "SIG-DRAFT-METADATA",
      "name": "涉密公文拟制法定元数据项",
      "pattern": "(?:定密依据|知悉范围|解密时间|保密期限)[:：]\\s*(?:\\d+年|长期|公布前|达到解密条件)",
      "severity": "HIGH",
      "description": "标密公文密级确认与保密期限法定元数据项"
    },
    {
      "id": "SIG-SECRECY-COPIES",
      "name": "涉密公文份号与版心排印",
      "pattern": "份号[:：]?\\s*[0-9]{6}",
      "severity": "HIGH",
      "description": "涉密公文顶端 6 位阿拉伯数字唯一印刷份号"
    }
  ],
